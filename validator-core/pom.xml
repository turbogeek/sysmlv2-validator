<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.validator</groupId>
        <artifactId>sysml-validator-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>validator-core</artifactId>
    <name>SysML v2 Validator - Core Library</name>
    <description>Core validation library with parser, semantic analysis, and error reporting</description>

    <dependencies>
        <!-- ANTLR Runtime -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
        </dependency>

        <!-- Apache Commons Text for spelling suggestions -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
        </dependency>

        <!-- Jackson for JSON parsing -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Apache Lucene for model indexing and search -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-queryparser</artifactId>
        </dependency>

        <!-- SLF4J for logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- SpotBugs annotations for bug pattern suppression -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>4.10.5</version>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <visitor>true</visitor>
                    <listener>true</listener>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The timing test runs in a JVM of its own (the performance-jvm profile below). In the JVM
                         shared by all test classes, the classes before it warm the JIT and ANTLR's prediction
                         cache, which is static: on 2026-10-25 that made the vehicle model's first build 15 s
                         instead of 27 s, so the recorded times depended on the order of the test classes.
                         -Dtest overrides this exclusion. -->
                    <excludes>
                        <exclude>**/SemanticAnalysisIntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Runs the timing test in a fresh JVM of its own, just before the other tests: in the test phase it
             would run after jacoco:report, whose report would then miss its coverage. Inactive with -Dtest, which
             selects the tests to run in the default JVM instead (-Dtest=SemanticAnalysisIntegrationTest runs it
             alone there). -->
        <profile>
            <id>performance-jvm</id>
            <activation>
                <property>
                    <name>!test</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>performance</id>
                                <phase>process-test-classes</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>**/SemanticAnalysisIntegrationTest.java</include>
                                    </includes>
                                    <excludes combine.self="override"/>
                                    <!-- Not ${argLine}, which holds JaCoCo's agent: its probes slow the validator
                                         but not the JDK code of the reference workload, which made the ratios
                                         1.1-1.5 x those without it on 2026-10-25. The timing test therefore adds
                                         no coverage. -Xshare:auto is the JVM's default, and keeps the value
                                         from being empty. -->
                                    <argLine>-Xshare:auto</argLine>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
